rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth & Role Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin' && getUserData().isActive == true;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow user creation on registration with role locked to 'user'
      allow create: if isOwner(userId) 
        && request.resource.data.role == 'user' 
        && request.resource.data.isActive == true;
      // Normal users cannot modify their own role, isActive, or creation date
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive', 'createdAt']))
                   || isAdmin();
      allow delete: if isAdmin();
      
      // User Subcollections
      match /bookmarks/{questionId} {
        allow read, write: if isOwner(userId);
      }
      
      match /questionStats/{questionId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // 2. Catalogs (Exams, Subjects)
    match /exams/{examId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // 3. Questions Bank
    match /questions/{questionId} {
      allow read: if (resource.data.status == 'published') || isAdmin();
      allow write: if isAdmin();
    }
    
    // 4. Mock Tests
    match /mockTests/{testId} {
      allow read: if (resource.data.isPublished == true) || isAdmin();
      allow write: if isAdmin();
    }
    
    // 5. Attempts
    match /attempts/{attemptId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // 6. Daily Challenges
    match /dailyChallenges/{date} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // 7. Leaderboards
    match /leaderboardScores/{scoreId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }
    
    // 8. Live Quiz Rooms
    match /liveRooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.hostId == request.auth.uid || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerCount', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;
      
      match /players/{playerId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(playerId);
      }
    }
  }
}
